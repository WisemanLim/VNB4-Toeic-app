# App runtime env (Expo auto-loads .env; only EXPO_PUBLIC_* are exposed to the bundle).
# Copy to `.env` for local dev:  cp .env.example .env
#
# Server target — login + ALL post-login requests (words/sentences/progress/analysis).
# Local web / iOS simulator: http://localhost:4000
# Android emulator:          http://10.0.2.2:4000
# Real device on LAN:        http://<your-machine-LAN-IP>:4000  (e.g. http://192.168.0.10:4000)
# Production:                set per EAS profile in eas.json (https://api.your-domain.com)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Force fully-offline mock for ALL requests (guest demo with zero backend).
# Leave empty/0 normally — guest already works offline, login uses the server.
# 1 = force mock everywhere (used by EAS development/preview profiles).
EXPO_PUBLIC_USE_MOCK=

# Optional environment label (informational): development | preview | production
EXPO_PUBLIC_ENV=development
