{
  "name": "@vnb4-toeic/app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TOEIC vocab mobile app (Expo / React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run.mjs android",
    "ios": "node scripts/run.mjs ios",
